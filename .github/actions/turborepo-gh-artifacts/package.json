{
  "name": "turborepo-gh-artifacts",
  "version": "4.1.1",
  "description": "A TurboRepo local cache server which uploads artifact cache to GH artifacts.",
  "license": "MIT",
  "author": "felixmosh",
  "main": "dist/index.js",
  "scripts": {
    "build": "rslib build && git add -f dist/",
    "release": "release-it --only-version",
    "update:major-tag": "TAG=$(git describe --tags `git rev-list --tags --max-count=1` | cut -b 1-2) && git tag -d $TAG && git push --delete origin $TAG && git tag $TAG && git push origin --tags"
  },
  "devDependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.0",
    "@rslib/core": "^0.20.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.12.0",
    "axios": "^1.13.6",
    "express": "^5.0.0",
    "fs-extra": "^11.3.4",
    "node-stream-zip": "^1.15.0",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --stdout --commit-limit false -u --template https://raw.githubusercontent.com/release-it/release-it/master/templates/changelog-compact.hbs"
    },
    "hooks": {
      "after:bump": [
        "npx auto-changelog -p",
        "yarn build"
      ]
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    }
  }
}
