# In addition to gitignore...
# Scoped to *.gjs/*.gts only (see .prettierrc.js) — these patterns just guard
# against picking up generated or vendored files if any ever appear there.

# generated files
dist
dist-test
unstable-preview-types
preview-types
warp-drive-packages/core/types

# unconventional
blueprints/
vendor/
!tests/blueprints/

# Markdown is deliberately unformatted: oxfmt ignores *.md (.oxfmtrc.jsonc) and
# lint:prettier only covers gjs/gts. Without this line the VS Code Prettier
# extension, which .vscode/settings.json makes the format-on-save default for
# every language, rewrites guides on save (*x* -> _x_, quotes and semicolons
# inside fenced code blocks) with changes no lint check asked for.
*.md
