{
  "name": "@fixture/kit",
  "version": "1.2.3",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./ambient": {
      "default": "./lib/ambient.js"
    },
    "./gone": {
      "default": "./lib/gone.js"
    },
    "./legacy/*": {
      "default": "./legacy/*.cjs"
    },
    "./*": {
      "unpkg": "./lib/unpkg/*.js",
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  }
}
