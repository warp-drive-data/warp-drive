{
  "name": "@ember-data/unpublished-test-infra",
  "version": "5.9.0-alpha.22",
  "private": true,
  "description": "The default blueprint for ember-data private packages.",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/warp-drive-data/warp-drive.git",
    "directory": "packages/unpublished-test-infra"
  },
  "license": "MIT",
  "author": "",
  "files": [
    "addon-main.cjs",
    "testem",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testem/*": {
      "default": "./testem/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build:pkg": "node node_modules/tsdown/dist/run.mjs",
    "prepack": "pnpm run build:pkg",
    "sync": "echo \"syncing\"",
    "check:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ember/test-helpers": "3.3.0 || ^4.0.4 || ^5.1.0",
    "@warp-drive/diagnostic": "workspace:*",
    "qunit": "^2.20.1",
    "testem": "^3.12.0"
  },
  "peerDependenciesMeta": {
    "qunit": {
      "optional": true
    },
    "testem": {
      "optional": true
    },
    "@warp-drive/diagnostic": {
      "optional": true
    }
  },
  "dependencies": {
    "@embroider/macros": "^1.20.6",
    "@warp-drive/core": "workspace:*",
    "@warp-drive/utilities": "workspace:*",
    "chalk": "^4.1.2",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-typescript": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@ember/test-helpers": "5.2.0",
    "@glimmer/component": "^2.0.0",
    "@types/qunit": "2.19.13",
    "@types/semver": "^7.7.0",
    "@warp-drive/diagnostic": "workspace:*",
    "@warp-drive/internal-config": "workspace:*",
    "ember-source": "~6.12.0",
    "qunit": "^2.20.1",
    "testem": "^3.12.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  },
  "volta": {
    "extends": "../../package.json"
  }
}
