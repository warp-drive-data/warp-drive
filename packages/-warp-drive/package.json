    "CHANGELOG.md",
    "README.md",
    "LICENSE.md",
    "logos"
  ],
  "type": "module",
  "dependencies": {
    "@embroider/macros": "^1.20.6",
    "@manypkg/get-packages": "^3.1.0",
    "@warp-drive/core": "workspace:*",
    "chalk": "^5.3.0",
    "comment-json": "^4.2.5",
    "debug": "^4.4.1",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-typescript": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/semver": "^7.7.1",
    "@warp-drive/internal-config": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "volta": {
    "extends": "../../package.json"
  }
