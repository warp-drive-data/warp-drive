{
  "name": "@ember-data/codemods",
  "version": "5.9.0-alpha.24",
  "description": "Codemods for WarpDrive/EmberData paradigms",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:warp-drive-data/warp-drive.git",
    "directory": "packages/codemods"
  },
  "type": "module",
  "bin": {
    "codemods": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "sync": "echo \"syncing\"",
    "build:pkg": "node node_modules/tsdown/dist/run.mjs",
    "prepack": "pnpm run build:pkg",
    "check:types": "node ./node_modules/typescript-7/bin/tsc --noEmit"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema-migration/*": {
      "default": "./src/schema-migration/*"
    }
  },
  "files": [
    "dist/index.js",
    "src",
    "utils",
    "LICENSE.md",
    "logos"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ast-grep/napi": "^0.45.1"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "catalog:",
    "@warp-drive/internal-config": "workspace:*",
    "commander": "^14.0.3",
    "eslint": "^10.8.1",
    "ignore": "^7.0.6",
    "jscodeshift": "^17.4.0",
    "tsdown": "^0.22.14",
    "typescript-7": "npm:typescript@7.1.0-dev.20260821.1",
    "winston": "^3.19.0"
  }
}
