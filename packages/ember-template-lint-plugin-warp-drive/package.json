{
  "name": "ember-template-lint-plugin-warp-drive",
  "description": "ember-template-lint rules for Applications using WarpDrive or EmberData",
  "type": "module",
  "main": "./dist/index.js",
  "version": "5.9.0-alpha.19",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/warp-drive-data/warp-drive.git",
    "directory": "packages/ember-template-lint-plugin-warp-drive"
  },
  "keywords": [
    "ember-template-lint",
    "ember-template-lint-plugin"
  ],
  "volta": {
    "extends": "../../package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build:pkg": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build:pkg",
    "check:pkg-types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --quiet --cache --cache-strategy=content"
  },
  "peerDependencies": {
    "ember-template-lint": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@glimmer/syntax": "^0.95.0"
  },
  "devDependencies": {
    "@warp-drive/internal-config": "workspace:*",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.34.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  },
  "license": "MIT"
}
