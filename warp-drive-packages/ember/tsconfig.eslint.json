{
  // ESLint's type-aware rules build their Program via the classic `typescript`
  // package, not TS 7's content-mapper. tsconfig.json's `types: []` is required
  // for `check:types` (TS 7's own type resolution needs no help), but without
  // these two ambient-type packages classic TS can't resolve most ember/glint
  // globals, so `@typescript-eslint/*` rules degrade into false positives
  // across the board (no-unsafe-*, no-unnecessary-type-assertion, etc).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@glint/ember-tsc/types", "ember-source/types"]
  }
}
