{
  "name": "@warp-drive/experiments",
  "description": "Experimental features for WarpDrive",
  "version": "0.2.7-alpha.20",
  "license": "MIT",
  "author": "Chris Thoburn <runspired@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:warp-drive-data/warp-drive.git",
    "directory": "warp-drive-packages/experiments"
  },
  "homepage": "https://github.com/warp-drive-data/warp-drive",
  "bugs": "https://github.com/warp-drive-data/warp-drive/issues",
  "exports": {
    "./document-storage": {
      "types": "./declarations/document-storage.d.ts",
      "default": "./dist/document-storage.js"
    },
    "./data-worker": {
      "types": "./declarations/data-worker.d.ts",
      "default": "./dist/data-worker.js"
    },
    "./worker-fetch": {
      "types": "./declarations/worker-fetch.d.ts",
      "default": "./dist/worker-fetch.js"
    },
    "./image-worker": {
      "types": "./declarations/image-worker.d.ts",
      "default": "./dist/image-worker.js"
    },
    "./image-fetch": {
      "types": "./declarations/image-fetch.d.ts",
      "default": "./dist/image-fetch.js"
    },
    "./streaming-fetch": {
      "types": "./declarations/streaming-fetch.d.ts",
      "default": "./dist/streaming-fetch.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "declarations",
    "CHANGELOG.md",
    "README.md",
    "LICENSE.md",
    "logos"
  ],
  "scripts": {
    "lint": "eslint . --quiet --cache --cache-strategy=content",
    "build:pkg": "tsdown",
    "prepack": "pnpm run build:pkg",
    "sync": "echo \"syncing\"",
    "start": "tsdown --watch"
  },
  "peerDependencies": {
    "@sqlite.org/sqlite-wasm": "3.46.0-build2",
    "@warp-drive/core": "workspace:*",
    "@warp-drive/utilities": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    }
  },
  "dependencies": {
    "@embroider/macros": "^1.20.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-transform-typescript": "^7.28.0",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@sqlite.org/sqlite-wasm": "3.46.0-build2",
    "@warp-drive/core": "workspace:*",
    "@warp-drive/utilities": "workspace:*",
    "@warp-drive/internal-config": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "keywords": [
    "ember-addon"
  ],
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  }
}
