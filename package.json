{
  "name": "root",
  "version": "5.9.0-alpha.23",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:warp-drive-data/warp-drive.git"
  },
  "scripts": {
    "takeoff": "FORCE_COLOR=2 pnpm install --prefer-offline --reporter=append-only",
    "prepare": "turbo run build:pkg --log-order=stream --concurrency=$(./bin/calculate-jobs);",
    "release": "./tools/release/index.ts",
    "build": "turbo run build:pkg --log-order=stream --concurrency=$(./bin/calculate-jobs);",
    "sync": "pnpm --filter './packages/*' --filter './warp-drive-packages/*' --filter './tests/*' --filter './specs' run --parallel --if-present sync",
    "start": "turbo run start --filter=./packages/* --concurrency=23",
    "start:specs": "turbo run start --filter=./specs",
    "sync:specs": "pnpm --filter './specs' run sync",
    "preview": "cd docs-viewer && pnpm start",
    "lint:tests": "turbo --log-order=stream lint --filter=./tests/* --continue --concurrency=$(./bin/calculate-jobs)",
    "lint:pkg": "turbo --log-order=stream lint --filter=./packages/* --continue --concurrency=$(./bin/calculate-jobs)",
    "lint": "turbo --log-order=stream lint --continue --concurrency=$(./bin/calculate-jobs)",
    "lint:fix": "turbo --log-order=stream lint --continue --concurrency=$(./bin/calculate-jobs) -- --fix",
    "lint:prettier": "prettier --check --cache --cache-location=.prettier-cache --log-level=warn .",
    "lint:prettier:fix": "prettier --write --cache --cache-location=.prettier-cache --log-level=warn .",
    "preinstall": "npx only-allow pnpm",
    "check:types": "turbo --log-order=stream check:types --continue --concurrency=$(./bin/calculate-jobs)",
    "test": "pnpm turbo test --concurrency=1 --log-order=stream",
    "test:production": "pnpm turbo test:production --concurrency=1 --log-order=stream",
    "test:blueprints": "pnpm run -r --workspace-concurrency=-1 --if-present test:blueprints"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.10.0",
    "@glint/template": "^1.8.0",
    "@warp-drive/internal-docs-viewer": "workspace:*",
    "@warp-drive/internal-tooling": "workspace:*",
    "badge-maker": "5.0.2",
    "bun-types": "^1.4.0",
    "comment-json": "^4.6.2",
    "debug": "^4.4.3",
    "ember-source": "catalog:",
    "execa": "^9.6.1",
    "git-repo-version": "^1.0.2",
    "lerna-changelog": "^2.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "semver": "^7.8.5",
    "silent-error": "^1.1.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "turbo": "^2.10.11"
  },
  "engines": {
    "node": ">= 25.9.0",
    "yarn": "use pnpm",
    "npm": "use pnpm",
    "pnpm": "10.34.5"
  },
  "volta": {
    "node": "25.9.0",
    "pnpm": "10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "changelog": {
    "cacheDir": ".changelog-cache",
    "labels": {
      ":label: breaking": ":boom: Breaking Change",
      ":label: feat": ":rocket: Enhancement",
      ":label: bug": ":bug: Bug Fix",
      ":label: perf:": ":zap: Performance",
      ":label: cleanup": ":shower: Deprecation Removal",
      ":label: deprecation": ":evergreen_tree: New Deprecation",
      ":label: doc": ":memo: Documentation",
      ":label: test": ":goal_net: Test",
      ":label: chore": ":house: Internal"
    },
    "ignoreCommitters": [
      "[bot]",
      "dependabot-bot",
      "greenkeeperio-bot",
      "renovate-bot",
      "Copilot"
    ]
  },
  "pnpm": {
    "packageExtensions": {
      "vitepress-plugin-group-icons": {
        "peerDependencies": {
          "vite": "*"
        }
      },
      "typedoc-vitepress-theme": {
        "peerDependencies": {
          "typedoc": "*"
        }
      },
      "@glimmer/syntax": {
        "dependencies": {
          "@glimmer/env": "^0.1.7"
        }
      },
      "ember-page-title": {
        "peerDependencies": {
          "@glimmer/component": "*",
          "ember-source": "*"
        }
      },
      "ember-source": {
        "peerDependencies": {
          "@glimmer/component": "*"
        }
      }
    },
    "overrides": {
      "@embroider/macros": "^1.20.6",
      "ember-auto-import": "^2.13.1",
      "@embroider/addon-shim>broccoli-funnel": "-",
      "ember-cli-babel>broccoli-funnel": "-",
      "qunit-console-grouper>broccoli-funnel": "-",
      "broccoli-merge-trees": "^4.2.0",
      "@glimmer/validator": "^0.95.0",
      "@glint/ember-tsc": "1.10.0",
      "@glint/template": "1.8.0",
      "@glint/tsserver-plugin": "2.7.0",
      "ember-cli-babel": "^8.3.1",
      "@embroider/macros>ember-cli-babel": "-",
      "ember-source>ember-cli-babel": "-",
      "ember-source>broccoli-file-creator": "-",
      "ember-source>ember-cli-get-component-path-option": "-",
      "ember-source>ember-cli-normalize-entity-name": "-",
      "ember-source>ember-cli-path-utils": "-",
      "ember-source>ember-cli-string-utils": "-",
      "ember-source>ember-cli-typescript-blueprint-polyfill": "-",
      "ember-source>ember-cli-version-checker": "-",
      "ember-cli-htmlbars": "^7.0.1",
      "qunit": "2.26.0",
      "ember-compatibility-helpers": "^1.2.7",
      "testem": "~3.20.1",
      "typescript": "5.9.3",
      "@types/bun": "1.3.14",
      "bun-types": "1.3.14",
      "lodash": "^4.18.1",
      "caniuse-lite": "^1.0.30001809",
      "rollup": "^4.62.4",
      "@babel/types": "^7.29.8",
      "@babel/parser": "^7.29.8",
      "@babel/traverse": "^7.29.8",
      "prettier": "^3.8.1",
      "@types/node": "catalog:",
      "@vue/compiler-sfc": "3.5.41",
      "@shikijs/langs": "4.4.3",
      "string.prototype.matchall": "npm:@nolyfill/string.prototype.matchall@^1"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "rsvp",
        "@glimmer/component",
        "search-insights",
        "@pnpm/logger",
        "@algolia/client-search"
      ],
      "allowAny": [
        "ember-source",
        "@glimmer/component",
        "typescript",
        "@pnpm/logger"
      ]
    },
    "allowUnusedPatches": true,
    "patchedDependencies": {
      "qunit@2.19.4": "patches/qunit@2.19.4.patch",
      "testem@3.11.0": "patches/testem@3.11.0.patch",
      "@ember/test-helpers@3.3.0": "patches/@ember__test-helpers@3.3.0.patch",
      "@ember/test-helpers@4.0.4": "patches/@ember__test-helpers@4.0.4.patch",
      "@ember/test-helpers@5.1.0": "patches/@ember__test-helpers@5.1.0.patch",
      "@ember/test-helpers@5.2.0": "patches/@ember__test-helpers@5.2.0.patch",
      "ember-source@4.4.5": "patches/ember-source@4.4.5.patch",
      "ember-source@3.28.12": "patches/ember-source@3.28.12.patch"
    }
  }
}
