{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current File (Node)",

      // The path to a JavaScript or TypeScript file to run. Node runs `.ts` files directly.
      "program": "${file}",

      // The arguments to pass to the program, if any.
      "args": [],

      // The working directory of the program.
      "cwd": "${workspaceFolder}",

      // The environment variables to pass to the program.
      "env": {},

      // If the debugger should stop on the first line of the program.
      "stopOnEntry": false,

      // Skip node's own internals when stepping.
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Node",

      // Attach to a process started with `node --inspect` (default port 9229).
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
