{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current File (Node)",

      // The path to a JavaScript or TypeScript file to run. Node runs the repo's own
      // node scripts directly, `.ts` included: scripts/*.mjs, tools/internal-tooling/src,
      // tools/release, docs-viewer/src and packages/schema/src. Package sources under
      // packages/* and warp-drive-packages/* use extensionless imports and TS-only syntax
      // that node cannot run; debug those through their test apps instead.
      "program": "${file}",

      // The arguments to pass to the program, if any.
      "args": [],

      // The working directory of the program.
      "cwd": "${workspaceFolder}",

      // The environment variables to pass to the program.
      "env": {},

      // If the debugger should stop on the first line of the program.
      "stopOnEntry": false,

      // Skip node's own internals when stepping.
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Node",

      // Attach to a process started with `node --inspect` (default port 9229).
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
