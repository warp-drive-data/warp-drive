# See https://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/docs/
/packages/-ember-data/docs/
concat-stats-for
dist
dist-*
cjs-dist
# transient release-packaging output synthesized from dist/ for alpha/beta
# types-strategy packages (see tools/release/core/publish/steps/generate-tarballs.ts)
unstable-preview-types
preview-types
tmp
packages/*/addon
.svelte-kit/
docs-viewer/docs.warp-drive.io/.vitepress/cache


# dependencies
bower_components
node_modules
scripts/asset-size-tracking/current-data.json

# misc
.turbo/
.env*
.pnp*
!.pnpmfile.cjs
.prettier-cache
.sass-cache
.eslintcache
/onnect.lock
coverage/*
libpeerconnection.log
npm-debug.log*
testem.log
test-execution-*.json
yarn-error.log
.broccoli-cache
tsconfig.tsbuildinfo

# Ignore artifacts of publishing
*.tgz

# ember-try
.node_modules.ember-try/
bower.json.ember-try
package.json.ember-try

# ember-data specific
benchmarks/results/*.json

.DS_Store

.github-upload-token
*.swp
.metadata_never_index

/DEBUG
/packages/*/DEBUG
/tests/*/DEBUG

!.vscode/
.idea/
*.iml

# Ignore generated output for the docs website
docs-viewer/docs.warp-drive.io/.vitepress/dist
docs-viewer/docs.warp-drive.io/.vitepress/cache
docs-viewer/docs.warp-drive.io/guides
docs-viewer/docs.warp-drive.io/api
docs-viewer/docs.warp-drive.io/skills
docs-viewer/docs.warp-drive.io/public/logos

vite.config.mjs.timestamp-*

node-compile-cache
.changelog-cache

# Claude Code local files
.claude/*.local.*

# Worktrees nested here by Claude Code's built-in mechanisms (--worktree,
# EnterWorktree, agent isolation). Nested worktrees are NOT how this repo wants
# to work — Node resolves node_modules upward, so they pick up the outer
# checkout's dependencies; use a sister worktree instead (see
# skills/contributors/start-in-a-fresh-worktree.md). Ignored so that a nested
# one arriving anyway doesn't show up as a repo's worth of untracked files.
.claude/worktrees/
