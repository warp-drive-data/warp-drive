{
  "name": "@warp-drive/legacy-tests",
  "version": "5.9.0-alpha.23",
  "private": true,
  "description": "A data layer for your Ember applications.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:warp-drive-data/warp-drive.git",
    "directory": "tests/legacy"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "sync": "echo \"syncing\"",
    "build:tests": "export IS_TESTING=true; export NODE_ENV=development; vite build -m development --outDir dist-test",
    "build:production": "export IS_TESTING=true; export NODE_ENV=production; vite build --outDir dist-test",
    "lint": "eslint . --quiet --cache --cache-strategy=content",
    "check:types": "ember-tsc --noEmit",
    "start": "export IS_TESTING=true; export NODE_ENV=development; vite build -m development --watch --outDir dist-test",
    "test": "export IS_TESTING=true; export NODE_ENV=development; bun ./diagnostic.js",
    "test:production": "export IS_TESTING=true; export NODE_ENV=production; bun ./diagnostic.js",
    "test:start": "bun ./diagnostic.js --serve --no-launch"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember-data/unpublished-test-infra": "workspace:*",
    "@ember/test-helpers": "5.2.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/core": "^4.4.2",
    "@embroider/macros": "^1.20.6",
    "@embroider/vite": "^1.5.0",
    "@glimmer/component": "^2.0.0",
    "@glint/ember-tsc": "^1.10.0",
    "@glint/template": "^1.8.0",
    "@glint/tsserver-plugin": "^2.7.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@warp-drive-internal/specs": "workspace:*",
    "@warp-drive/core": "workspace:*",
    "@warp-drive/diagnostic": "workspace:*",
    "@warp-drive/ember": "workspace:*",
    "@warp-drive/holodeck": "workspace:*",
    "@warp-drive/internal-config": "workspace:*",
    "@warp-drive/json-api": "workspace:*",
    "@warp-drive/legacy": "workspace:*",
    "@warp-drive/utilities": "workspace:*",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "decorator-transforms": "^2.4.0",
    "ember-source": "~6.12.0",
    "ember-strict-application-resolver": "^0.1.0",
    "eslint-plugin-warp-drive": "workspace:*",
    "rollup": "^4.62.4",
    "terser": "^5.39.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "ember": {
    "edition": "octane"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "packageManager": "pnpm@10.12.4"
}
