{
  "include": ["index.mts", "tests/**/*.mts"],
  // how do I set this up where it only applies to
  // this sub-directory?
  "compilerOptions": {
    "lib": ["esnext"],
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "strict": true,
    "pretty": true,
    "alwaysStrict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  }
}
