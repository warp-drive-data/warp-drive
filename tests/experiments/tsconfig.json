{
  "include": ["tests/**/*", "start.ts"],
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "pretty": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "disableSourceOfProjectReferenceRedirect": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": false,
    "incremental": true,
    "declaration": true,
    "types": ["ember-source/types", "vite/client", "@glint/ember-tsc/types"],
    // "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "composite": true,
    "declarationDir": "unstable-preview-types",
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "rootDir": ".",
    "checkJs": false
  },
  "references": [
    {
      "path": "../../packages/diagnostic"
    },
    {
      "path": "../../warp-drive-packages/ember"
    },
    {
      "path": "../../warp-drive-packages/json-api"
    },
    {
      "path": "../../warp-drive-packages/utilities"
    },
    {
      "path": "../../packages/holodeck"
    },
    {
      "path": "../../warp-drive-packages/experiments"
    },
    {
      "path": "../../warp-drive-packages/core"
    }
  ]
}
