{
  "include": ["tests/**/*", "start.ts"],
  "contentMappers": [{ "package": "ember-content-mapper", "extensions": [".gts", ".gjs"] }],
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "pretty": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "disableSourceOfProjectReferenceRedirect": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": false,
    "incremental": true,
    "declaration": true,
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "composite": true,
    "declarationDir": "unstable-preview-types",
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "erasableSyntaxOnly": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "rootDir": ".",
    "checkJs": false
  },
  "references": [
    {
      "path": "../../specs"
    },
    {
      "path": "../../packages/diagnostic"
    },
    {
      "path": "../../warp-drive-packages/ember"
    },
    {
      "path": "../../warp-drive-packages/core"
    },
    {
      "path": "../../warp-drive-packages/utilities"
    },
    {
      "path": "../../warp-drive-packages/json-api"
    },
    {
      "path": "../../packages/holodeck"
    }
  ]
}
