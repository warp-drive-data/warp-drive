{
  // See warp-drive-packages/ember/tsconfig.eslint.json for why this exists:
  // ESLint's type-aware rules use classic `typescript`, not TS 7's content
  // mapper, and need the ambient ember/glint types (and the `baseUrl` TS 7
  // doesn't support) that tsconfig.json no longer includes.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["@glint/ember-tsc/types", "ember-source/types", "vite/client"]
  }
}
